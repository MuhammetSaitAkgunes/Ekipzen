{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ekipzen-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "3210", "legacy-frontend"],
      "port": 3210
    },
    {
      "name": "ekipzen-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/Ekipzen.API", "--launch-profile", "http"],
      "port": 5053
    },
    {
      "name": "ekipzen-api-noseed",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/Ekipzen.API", "--launch-profile", "http", "--", "--Seed:Enabled=false"],
      "port": 5053
    },
    {
      "name": "ekipzen-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
