{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "PlatformConnection": ""
  },
  "Jwt": {
    "Issuer": "Ekipzen",
    "Audience": "EkipzenFrontend",
    "Secret": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Email": {
    "_comment": "Mode: 'outbox' (varsayılan, dev/demo — dosyaya yazar) | 'smtp' (üretim). smtp seçilirse aşağıdaki Smtp bloğu (Host+From) zorunludur; şifreyi buraya YAZMAYIN, ortam değişkeninden (Smtp__Password) verin.",
    "Mode": "outbox"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Ekipzen",
    "UseStartTls": true
  },
  "Cleanup": {
    "UnverifiedTenants": {
      "_comment": "Doğrulanmamış (hiç etkinleşmemiş) eski self-servis kiracıların uygulama-içi periyodik silinmesi. Yıkıcı işlem — varsayılan kapalı; üretimde bilinçli açın.",
      "Enabled": false,
      "IntervalHours": 24,
      "OlderThanDays": 30
    }
  },
  "IdentityProvisioning": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "BatchSize": 50
  },
  "AllowedHosts": "*"
}
