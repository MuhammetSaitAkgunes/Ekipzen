<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <BuildFrontendForPublish>true</BuildFrontendForPublish>
    <PublishUrl>$(MSBuildProjectDirectory)/../../../artifacts/visual-studio/site/</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)/../../../artifacts/visual-studio/site/</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
